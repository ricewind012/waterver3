{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"assist": {
		"actions": {
			"source": {
				"organizeImports": {
					"level": "on",
					"options": {
						"groups": [":PACKAGE:", ":BLANK_LINE:", ":PATH:"]
					}
				},
				"useSortedKeys": "on"
			}
		}
	},
	"overrides": [
		{
			"assist": {
				"actions": {
					"source": {
						"useSortedKeys": "off",
						"useSortedPackageJson": "on"
					}
				}
			},
			"includes": ["**/package.json"]
		}
	]
}
